# Clerk (auth) — https://dashboard.clerk.com
# Usar pk_live_/sk_live_ en producción, pk_test_/sk_test_ solo en local/dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/campus/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/campus
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/campus

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# La anon key es pública por diseño. Tras la migración 014 todas las
# tablas de datos de usuario están cerradas a anon (solo service_role).
# La anon key solo se usa ya server-side para catálogo público.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreto, solo server-side (service.ts) — nunca exponer al cliente.
# Toda la autorización de datos de usuario depende de este cliente +
# verificación de identidad con Clerk en Server Actions/Components.
SUPABASE_SERVICE_ROLE_KEY=

# Cron keep-alive (evita pausa Supabase por inactividad) — string random cualquiera
CRON_SECRET=

# Resend (envío de emails) — https://resend.com/api-keys
RESEND_API_KEY=
# Destinatarios de contacto/leads (antes hardcodeados en código)
CONTACT_EMAIL_TO=
LEADS_EMAIL_TO=
# Remitente de correos transaccionales. BLOQUEANTE producción: verificar dominio
# propio en Resend (SPF/DKIM) y poner aquí p.ej. "La Trastienda <hola@latrastienda.es>".
# Si se deja vacío usa onboarding@resend.dev (dominio de test).
RESEND_FROM=
RESEND_REPLY_TO=latrastienda.retail@gmail.com

# Datos del responsable del tratamiento (pie legal RGPD de los correos).
# Si se dejan vacíos usa los valores ya publicados en /privacidad (AEDTER).
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_NIF=
LEGAL_ENTITY_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_EMAIL=

# Sesión 1:1 KPIs — correo diferido 3 días tras comprar el curso marcado con upsell_1to1
KPI_1TO1_CAL_URL=
KPI_1TO1_PROMO_CODE=KPI1A1-20
KPI_1TO1_PRICE=120 €
KPI_1TO1_PRICE_DISCOUNT=96 €
KPI_1TO1_DISCOUNT_LABEL=−20 %
KPI_1TO1_PROMO_EXPIRY_DAYS=30

# Stripe — https://dashboard.stripe.com/apikeys
# Usar claves live (sk_live_/pk_live_) en producción, test (sk_test_/pk_test_) en local/dev
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Generado al registrar el webhook (scripts/setup-stripe-webhook.mjs)
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Klarna / pago aplazado: activar en Stripe Dashboard → Settings → Payment methods.
# No hace falta config de código: al no fijar payment_method_types, Checkout usa el dashboard.

# URL pública del sitio (sin slash final), usada en emails, checkout redirects, etc.
NEXT_PUBLIC_URL=https://www.latrastienda.example

# PostHog (analytics) — https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# LinkedIn Insight Tag (opcional, no bloqueante)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
